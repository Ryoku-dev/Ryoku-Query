[Unit]
Description=Nero Discord support bot
Wants=network-online.target nero-llm.service
After=network-online.target nero-llm.service

[Service]
Type=simple
User=nero
Group=nero
WorkingDirectory=/opt/nero/app
EnvironmentFile=/etc/nero/nero.env
# Print statements reach the journal as they happen instead of when a buffer fills.
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/nero/venv/bin/python -B bot.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/nero
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
