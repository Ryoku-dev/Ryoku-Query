TOKEN=TOKEN_HERE
MODEL_NAME=minishlab/potion-base-32M
SUPPORT_PATH=./data/support.json
# The one channel where Nero answers normal messages without an @mention.
# Set 0 to require an @mention or a reply everywhere.
SUPPORT_CHANNEL_ID=0
# Local SQLite feedback journal. Keep this outside Git and back it up with runtime data.
FEEDBACK_DB_PATH=./runtime/nero-feedback.sqlite3
# Clone the stable Ryoku repo first, then point this at that checkout.
# Example: git clone https://github.com/ryoku-dev/ryoku-arch.git /path/to/ryoku
RYOKU_REPO_PATH=/path/to/ryoku
PROWL_TIMEOUT_SECONDS=4
PROWL_RESULT_LIMIT=20
# Absolute path is recommended for a service/venv process; it prevents PATH drift.
PROWL_AGENT_PATH=/home/neur0map/workspace/prowl-agent/prowl-agent

# Local-only Ollama. Keep both models installed, but never keep both resident:
# Gemma handles normal reviewed support answers; LFM is used only for cited diagnostics.
OLLAMA_HOST=http://127.0.0.1:11434
GEMMA_MODEL=gemma4:e4b
LFM_MODEL=lfm2.5:latest
OLLAMA_TIMEOUT_SECONDS=120
